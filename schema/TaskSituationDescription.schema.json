        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        }
      },
      "required": [
        "ref"
      ],
      "title": "TSDRequiredObject",
      "type": "object"
    },
    "TSDTargetObjects": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "items": {
            "$ref": "#/$defs/TSDRequiredObject"
          },
          "title": "Required",
          "type": "array"
        },
        "key_means": {
          "items": {
            "$ref": "#/$defs/TSDKeyMeans"
          },
          "title": "Key Means",
          "type": "array"
        },
        "auxiliary": {
          "items": {
            "$ref": "#/$defs/TSDAuxiliaryObject"
          },
          "title": "Auxiliary",
          "type": "array"
        }
      },
      "title": "TSDTargetObjects",
      "type": "object"
    },
    "TaskGoal": {
      "additionalProperties": false,
      "description": "작업 목표. 사람이 읽는 요약과, 그것을 기계가 확인할 수 있게 옮긴 목표 상태.",
      "properties": {
        "summary": {
          "description": "사람이 읽는 최종 목적 한 문장",
          "title": "Summary",
          "type": "string"
        },
        "goal_state": {
          "description": "작업을 마쳤을 때의 상태. 만족하는 경우마다 단언 목록 하나 (경우 안은 모두 성립, 경우 중 하나면 된다)",
          "items": {
            "items": {
              "$ref": "#/$defs/GoalAssertion"
            },
            "type": "array"
          },
          "title": "Goal State",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "TaskGoal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_goal": {
      "$ref": "#/$defs/TaskGoal"
    },
    "spatiotemporal_conditions": {
