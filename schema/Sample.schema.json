          "default": false,
          "title": "Trivial",
          "type": "boolean"
        }
      },
      "required": [
        "pass",
        "initial_status"
      ],
      "title": "GoalCheckResult",
      "type": "object"
    },
    "GoalOracleResult": {
      "additionalProperties": false,
      "description": "원천이 알려 준 성공 판정(정답)과 생성된 목표 상태의 대조. 원천이 모르면 available=false.",
      "properties": {
