    "GoalAssertion": {
      "additionalProperties": false,
      "description": "작업을 마쳤을 때 성립해야 하는(또는 성립하지 않아야 하는) 상태 단언 하나. 행동이나 순서가 아니라 상태이며, 현재 씬 상태와 같은 어휘(관계 술어, 상태 키, entity id)로 쓴다. 적은 것만 확인 대상이고, 적지 않은 상태는 \"바뀌면 안 됨\"이 아니라 \"상관없음\"이다.",
      "properties": {
        "kind": {
          "description": "단언 종류: relation(관계), state(물체나 가구의 상태)",
          "title": "Kind",
          "type": "string"
        },
        "subject": {
          "description": "주어 entity id (환경 컨텍스트의 물체·가구 id)",
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "description": "relation이면 관계 술어, 상태 단언이면 상태 키",
          "title": "Predicate",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "relation의 대상. 로봇이 드는 관계와 상태 단언은 null",
          "title": "Object"
        },
        "value": {
          "default": true,
          "description": "true면 성립해야 하고 false면 성립하지 않아야 한다",
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "subject",
        "predicate"
      ],
      "title": "GoalAssertion",
      "type": "object"
    },
    "GoalCheckResult": {
      "additionalProperties": false,
      "description": "목표 상태·완료 판정의 규칙 검사 결과.",
      "properties": {
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "problems": {
          "items": {
            "type": "string"
