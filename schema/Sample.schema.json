              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall"
        },
        "alternatives": {
          "default": 1,
          "title": "Alternatives",
          "type": "integer"
        },
        "chosen": {
          "default": 0,
          "title": "Chosen",
          "type": "integer"
        }
      },
      "required": [
        "pass",
        "available"
      ],
      "title": "GoalOracleResult",
      "type": "object"
    },
